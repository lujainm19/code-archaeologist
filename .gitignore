# Don't track the cloned target repo or generated data
# since this project is about to clone the entire httpx repository (thousands of files) onto this computer so we can read its history,
# but I do not want that huge external repo accidentally becoming part of my GitHub repo, that would be like accidentally committing someone else's entire library into my own project

# ignore anything inside a folder called "data" (where we save commit history JSON, and where the cloned repo temporarily lives)
data/

# ignore Python's auto-generated bytecode cache folders
__pycache__/

# ignore individual compiled Python files (the * means "match anything ending in .pyc")
*.pyc